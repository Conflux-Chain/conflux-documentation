{
  "name": "conflux-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "front-matter": "node scripts/add-front-matter.js",
    "start": "pnpm front-matter && docusaurus start",
    "build": "pnpm front-matter && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "pnpm front-matter && docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "pnpm front-matter && docusaurus serve",
    "zh": "pnpm start --locale zh-CN",
    "es": "pnpm start --locale es",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "dependencies": {
    "@docsearch/docusaurus-adapter": "4.7.1",
    "@docusaurus/core": "3.10.2",
    "@docusaurus/plugin-content-docs": "3.10.2",
    "@docusaurus/plugin-ideal-image": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@mdx-js/react": "^3.1.1",
    "autoprefixer": "^10.6.2",
    "clsx": "^1.2.1",
    "postcss": "^8.5.32",
    "prism-react-renderer": "^2.4.1",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwindcss": "^3.4.19"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "3.10.2",
    "@docusaurus/types": "3.10.2",
    "@types/react": "^18.3.31",
    "gray-matter": "^4.0.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=22.0"
  },
  "packageManager": "pnpm@11.17.0"
}
