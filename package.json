{
  "name": "conflux-docs",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "docusaurus": "docusaurus",
    "front-matter": "node scripts/add-front-matter.js",
    "start": "pnpm front-matter && docusaurus start",
    "build": "pnpm front-matter && docusaurus build",
    "swizzle": "docusaurus swizzle",
    "deploy": "pnpm front-matter && docusaurus deploy",
    "clear": "docusaurus clear",
    "serve": "pnpm front-matter && docusaurus serve",
    "zh": "pnpm start --locale zh-CN",
    "es": "pnpm start --locale es",
    "write-translations": "docusaurus write-translations",
    "write-heading-ids": "docusaurus write-heading-ids"
  },
  "dependencies": {
    "@docusaurus/core": "^3.8.1",
    "@docusaurus/plugin-content-docs": "^3.8.1",
    "@docusaurus/plugin-ideal-image": "^3.8.1",
    "@docusaurus/preset-classic": "^3.8.1",
    "@docusaurus/theme-mermaid": "3.8.1",
    "@mdx-js/react": "^3.0.0",
    "autoprefixer": "^10.4.13",
    "clsx": "^1.2.1",
    "postcss": "^8.4.18",
    "prism-react-renderer": "^2.1.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-router-dom": "^6.16.0",
    "tailwindcss": "^3.2.1"
  },
  "devDependencies": {
    "@docusaurus/module-type-aliases": "^3.8.1",
    "@docusaurus/types": "^3.8.1",
    "@types/react": "^18.3.12",
    "gray-matter": "^4.0.3"
  },
  "browserslist": {
    "production": [
      ">0.5%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "engines": {
    "node": ">=18.0"
  },
  "packageManager": "pnpm@10.34.5"
}
